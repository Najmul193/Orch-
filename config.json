  "cooldownMinutes": 15,

  "claudeHandoff": false,
  "autoHandoff": false,
  "claudeProjectsDir": "~/.claude/projects",

  "autoPool": true,
  "poolLimit": 6,
  "poolPrefer": [
    "glm-5.3-flash-free",
    "deepseek-v4.1-flash-free",
    "nemotron-3-ultra-free",
    "nemotron-3.5-super-vl-free",
    "nemotron-3.5-lightning-free",
    "longcat-2.5-preview-free",
    "mimo-v2.6-flash-free",
    "beam-free",
    "space-bunny-free"
  ],
  "routing": {
    "code": ["glm-5.3-flash-free", "deepseek-v4.1-flash-free", "nemotron-3-ultra-free"],
    "ui": ["nemotron-3.5-super-vl-free", "glm-5.3-flash-free", "mimo-v2.6-flash-free"],
    "docs": ["deepseek-v4.1-flash-free", "beam-free", "space-bunny-free"],
    "research": ["nemotron-3.5-lightning-free", "beam-free", "glm-5.3-flash-free"],
