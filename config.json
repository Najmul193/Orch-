  "chains": {
    "delegate": [
      { "agent": "opencode", "model": "opencode/glm-5.3-flash-free", "enabled": true },
      { "agent": "opencode", "model": "opencode/deepseek-v4.1-flash-free", "enabled": true },
      { "agent": "agy", "model": "gemini-3.8-flash-medium", "enabled": true }
    ],
    "handoff": [
      { "agent": "agy", "model": "gemini-3.8-flash-high", "enabled": true },
      { "agent": "opencode", "model": "opencode/glm-5.3-flash-free", "enabled": true }
